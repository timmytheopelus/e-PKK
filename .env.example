# Salin ke .env.local (lokal) dan isi di Vercel > Settings > Environment Variables. JANGAN di-commit.
AUTH_SECRET=            # buat dengan: npx auth secret   (atau: openssl rand -base64 32)
AUTH_GOOGLE_ID=         # Google Cloud Console > OAuth client
AUTH_GOOGLE_SECRET=
AIRTABLE_TOKEN=         # Personal Access Token Airtable (lihat docs/SETUP.md)
